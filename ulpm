#!/usr/bin/env bash
#
# ULPM - Universal Linux Package Manager
# LPK Engine v3.3 (modular)
#

set -euo pipefail

ULPM_ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
LIB_DIR="$ULPM_ROOT/lib"

source "$LIB_DIR/common.sh"
source "$LIB_DIR/crypto.sh"
source "$LIB_DIR/db.sh"
source "$LIB_DIR/packaging.sh"
source "$LIB_DIR/sandbox.sh"
source "$LIB_DIR/cli.sh"

[[ $# -eq 0 ]] && usage

ACTION="$1"
shift || true

case "$ACTION" in
help|-h|--help) usage ;;
version|-v|--version)
echo "ULPM Engine v3.3 (.lpk spec v3)"
exit 0
;;
esac

init_runtime

if [[ "$ACTION" != "integrate" ]]; then
 ensure_integration
fi

case "$ACTION" in
 stream) cmd_stream "$@" ;;
 run) cmd_run "$@" ;;
 install|-i|add|-a) cmd_install_target "$@" ;;
 pack) lpk_pack "$@" ;;
 deb-pack) lpk_pack_from_apt "$@" ;;
 upgrade|-u) cmd_upgrade ;;
 remove|-r) cmd_remove "$@" ;;
 list|-l) cmd_list ;;
 clean) cmd_clean ;;
 integrate) cmd_integrate "$@" ;;
 keygen) cmd_keygen "$@" ;;
 sign) cmd_sign "$@" ;;
 trust) cmd_trust "$@" ;;
 *)
 echo -e "${RED}[-] Unknown command: $ACTION${NC}" >&2
 usage
 ;;
esac