#!/usr/bin/env bash
#
# ULPM - Universal Linux Package Manager
# LPK Engine v3.1 (Improved)
#
# Lightweight, rootless, zero-daemon, sandboxed package manager
# powered by Bubblewrap + SquashFS + Ed25519
#

set -euo pipefail

# ============================================================
# Configuration
# ============================================================

ULPM_FORMAT_VERSION=3
: "${ULPM_API_CACHE_TTL:=15}"
: "${ULPM_STRICT_SIGNATURES:=false}"

SIG_MAGIC="LPKSIG01"
SIG_MAGIC_LEN=8
SIG_RAW_LEN=64
SIG_PUB_LEN=32
SIG_FOOTER_TOTAL=104   # 64 + 32 +8

# Colors
BOLD='\033[1m'
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
GRAY='\033[0;90m'
NC='\033[0m'

# ============================================================
# Dependencies check
# ============================================================

REQUIRED_CMDS=(squashfuse mksquashfs bwrap jq file curl fusermount openssl tail head truncate)

for cmd in "${REQUIRED_CMDS[@]}"; do
    if ! command -v "$cmd" &>/dev/null; then
        echo -e "${RED}[-] Missing required tool: ${BOLD}$cmd${NC}" >&2
        exit 1
    fi
done

# ============================================================
# Paths (100% rootless)
# ============================================================

ULPM_DATA="${XDG_DATA_HOME:-$HOME/.local/share}/ulpm"
ULPM_APPS="$ULPM_DATA/apps"
ULPM_DB="$ULPM_DATA/installed.db"
CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/ulpm"
CACHE_API_DIR="$CACHE_DIR/api"
CACHE_PKG_DIR="$CACHE_DIR/pkgs"
DESKTOP_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/applications"
ICON_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/icons/hicolor/512x512/apps"

CONF_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/ulpm"
TRUSTED_KEYS_DIR="$CONF_DIR/trusted_keys"
DEFAULT_KEY="$CONF_DIR/ulpm_ed25519.key"
CONF_FILE="$CONF_DIR/ulpm.conf"

mkdir -p "$ULPM_APPS" "$CACHE_API_DIR" "$CACHE_PKG_DIR" \
         "$DESKTOP_DIR" "$ICON_DIR" "$TRUSTED_KEYS_DIR"
touch "$ULPM_DB"

TEMP_DIR=$(mktemp -d "/tmp/ulpm.XXXXXX")
cleanup_temp() {
    rm -rf -- "$TEMP_DIR" 2>/dev/null || true
}
trap cleanup_temp EXIT INT TERM

# ============================================================
# Architecture
# ============================================================

detect_arch() {
    local m
    m="$(uname -m)"
    case "$m" in
        x86_64|amd64)  echo "amd64" ;;
        aarch64|arm64) echo "arm64" ;;
        armv7*|armhf)  echo "armhf" ;;
        i386|i686)     echo "i386" ;;
        riscv64)       echo "riscv64" ;;
        *)             echo "$m" ;;
    esac
}

SYS_ARCH=$(detect_arch)

case "$SYS_ARCH" in
    amd64) ARCH_REGEX="x86_64|amd64|x64" ;;
    arm64) ARCH_REGEX="aarch64|arm64|armv8" ;;
    armhf) ARCH_REGEX="armv7l|armhf|arm" ;;
    i386)  ARCH_REGEX="i386|i686|x86" ;;
    *)     ARCH_REGEX="$SYS_ARCH" ;;
esac

# ============================================================
# GitHub helpers
# ============================================================

GITHUB_TOKEN="${GITHUB_TOKEN:-}"
if [[ -z "$GITHUB_TOKEN" && -f "$CONF_FILE" ]]; then
    raw_token=$(grep -E '^GITHUB_TOKEN=' "$CONF_FILE" 2>/dev/null | cut -d'=' -f2- || true)
    GITHUB_TOKEN=$(echo "$raw_token" | tr -d "\"'")
fi

fetch_github_api() {
    local endpoint="${1#https://api.github.com/}"
    endpoint="${endpoint#/}"
    local ttl="${2:-$ULPM_API_CACHE_TTL}"
    local cache_key cache_file
    cache_key=$(echo "$endpoint" | tr '/' '_')
    cache_file="${CACHE_API_DIR}/${cache_key}.json"

    if [[ -f "$cache_file" ]]; then
        if [[ "$ttl" -eq 0 ]]; then
            rm -f "$cache_file"
        else
            if ! find "$cache_file" -mmin "+$ttl" &>/dev/null; then
                cat "$cache_file"
                return 0
            fi
        fi
    fi

    local auth_header=()
    [[ -n "$GITHUB_TOKEN" ]] && auth_header=(-H "Authorization: Bearer $GITHUB_TOKEN")

    local response
    response=$(curl -sS --connect-timeout 10 --max-time 25 --retry 2 \
        "${auth_header[@]}" \
        -H "Accept: application/vnd.github+json" \
        -H "User-Agent: ulpm-client" \
        "https://api.github.com/${endpoint}" 2>/dev/null) || true

    if [[ -n "$response" ]] && echo "$response" | jq -e . >/dev/null 2>&1; then
        echo "$response" > "$cache_file"
        echo "$response"
        return 0
    fi

    if [[ -f "$cache_file" ]]; then
        cat "$cache_file"
        return 0
    fi
    return 1
}

find_lpk_download_url() {
    local json="$1" regex="$2"
    echo "$json" | jq -r '.assets[]? | "\(.name)\t\(.browser_download_url)"' 2>/dev/null \
        | grep -iE '\.lpk$' \
        | grep -iE "($regex)" \
        | head -n1 \
        | cut -f2 || true
}

find_archive_download_url() {
    local json="$1" regex="$2"
    echo "$json" | jq -r '.assets[]? | "\(.name)\t\(.browser_download_url)"' 2>/dev/null \
        | grep -iE '\.(appimage|deb|rpm|tar\.gz|tar\.xz|tgz|tar\.zst|zip)$' \
        | grep -iE "($regex)" \
        | grep -ivE "src|source|dev|doc|debug" \
        | head -n1 \
        | cut -f2 || true
}

# ============================================================
# Cryptography (Ed25519 self-contained footer)
# ============================================================

ensure_default_key() {
    [[ -f "$DEFAULT_KEY" ]] && return 0

    echo -e "${CYAN}-> Generating default Ed25519 keypair...${NC}"
    local pub_key="${DEFAULT_KEY%.key}.pub"

    if ! openssl genpkey -algorithm ed25519 -out "$DEFAULT_KEY" 2>/dev/null; then
        echo -e "${RED}[-] Failed to generate private key${NC}" >&2
        return 1
    fi
    chmod 600 "$DEFAULT_KEY"

    if ! openssl pkey -in "$DEFAULT_KEY" -pubout -out "$pub_key" 2>/dev/null; then
        echo -e "${RED}[-] Failed to derive public key${NC}" >&2
        rm -f "$DEFAULT_KEY" "$pub_key"
        return 1
    fi

    cp -f "$pub_key" "$TRUSTED_KEYS_DIR/default.pub"
    echo -e "${GREEN}✔ Default key created and trusted${NC}"
}

cmd_keygen() {
    local key_name="${1:-ulpm_ed25519}"
    local priv_key="$CONF_DIR/${key_name}.key"
    local pub_key="$CONF_DIR/${key_name}.pub"

    if [[ -f "$priv_key" ]]; then
        echo -e "${YELLOW}[!] Key already exists. Overwrite? (y/N)${NC}"
        read -r reply
        [[ ! "$reply" =~ ^[yYoO]$ ]] && return 0
    fi

    echo -e "${CYAN}-> Generating Ed25519 keypair: $key_name${NC}"
    openssl genpkey -algorithm ed25519 -out "$priv_key" 2>/dev/null || return 1
    chmod 600 "$priv_key"
    openssl pkey -in "$priv_key" -pubout -out "$pub_key" 2>/dev/null || return 1
    cp -f "$pub_key" "$TRUSTED_KEYS_DIR/${key_name}.pub"
    echo -e "${GREEN}✔ Key created and trusted: ${BOLD}$pub_key${NC}"
}

cmd_sign() {
    local pkg_path="${1:-}"
    local priv_key="${2:-$DEFAULT_KEY}"

    if [[ -z "$pkg_path" || ! -f "$pkg_path" ]]; then
        echo -e "${RED}[-] Specify a valid .lpk file to sign${NC}" >&2
        return 1
    fi
    if [[ ! -f "$priv_key" ]]; then
        echo -e "${RED}[-] Private key not found: $priv_key${NC}" >&2
        return 1
    fi

    local file_size
    file_size=$(stat -c %s "$pkg_path")
    if [[ "$file_size" -ge $SIG_FOOTER_TOTAL ]]; then
        local check_magic
        check_magic=$(tail -c "$SIG_MAGIC_LEN" "$pkg_path" 2>/dev/null || true)
        if [[ "$check_magic" == "$SIG_MAGIC" ]]; then
            echo -e "${YELLOW}[!] Stripping old signature footer...${NC}"
            truncate -s "-$SIG_FOOTER_TOTAL" "$pkg_path"
        fi
    fi

    local pub_raw="$TEMP_DIR/pub_raw.bin"
    local sig_raw="$TEMP_DIR/sig_raw.bin"

    openssl pkey -in "$priv_key" -pubout -outform DER 2>/dev/null | tail -c "$SIG_PUB_LEN" > "$pub_raw"

    if ! openssl pkeyutl -sign -rawin -inkey "$priv_key" -in "$pkg_path" -out "$sig_raw" 2>/dev/null; then
        echo -e "${RED}[-] Ed25519 signing failed${NC}" >&2
        return 1
    fi

    cat "$sig_raw" "$pub_raw" <(printf "%s" "$SIG_MAGIC") >> "$pkg_path"
    echo -e "${GREEN}✔ Package signed (embedded footer)${NC}"
}

cmd_trust() {
    local pub_key="${1:-}"
    if [[ -z "$pub_key" || ! -f "$pub_key" ]]; then
        echo -e "${RED}[-] Provide a valid .pub file${NC}" >&2
        return 1
    fi
    cp -f "$pub_key" "$TRUSTED_KEYS_DIR/$(basename "$pub_key")"
        echo -e "${GREEN}✔ Key added to trusted keyring${NC}"
}

verify_package_signature(){
    local pkg="$1"

    if [[ ! -f "$pkg" ]]; then
        echo -e "${RED}[-] Package not found: $pkg${NC}" >&2
        return 1
    fi

    local fsize
    fsize=$(wc -c < "$pkg")
    if [[ "$fsize" -lt $SIG_FOOTER_TOTAL ]]; then
        echo -e "${RED}[-] Security:file too small (missing footer)${NC}" >&2
        return 1
    fi

    local magic
    magic=$(tail -c "$SIG_MAGIC_LEN" "$pkg")
    if [[ "$magic" != "$SIG_MAGIC" ]]; then
        echo -e "${RED}[-] Security: missing LPK signature magic${NC}" >&2
        return 1
    fi

    local payload_size=$((fsize - SIG_FOOTER_TOTAL))
    local sig_bin="$TEMP_DIR/chk.sig"
    local pub_raw="$TEMP_DIR/chk_raw.pub"
    local pub_der="$TEMP_DIR/chk_full.pub"
    local data_stream="$TEMP_DIR/payload.bin"

    tail -c "$SIG_FOOTER_TOTAL" "$pkg" | head -c "$SIG_RAW_LEN" > "$sig_bin"
    tail -c $((SIG_PUB_LEN + SIG_MAGIC_LEN)) "$pkg" | head -c "$SIG_PUB_LEN" > "$pub_raw"
    head -c "$payload_size" "$pkg" > "$data_stream"

    printf '\x30\x2a\x30\x05\x06\x03\x2b\x65\x70\x03\x21\x00' > "$pub_der"
    cat "$pub_raw" >> "$pub_der"

    if ! openssl pkeyutl -verify -rawin -pubin -keyform DER\
-inkey "$pub_der" -in "$data_stream" -sigfile "$sig_bin" &>/dev/null; then
        echo -e "${RED}[-] CRITICAL: Cryptographic payload corruption or forged signature!${NC}" >&2
        rm -f "$sig_bin" "$pub_raw" "$pub_der" "$data_stream"
        return 1
    fi

    local matched=false
    local pub_keys=()
    shopt -s nullglob
    pub_keys=("$TRUSTED_KEYS_DIR"/*.pub)
    shopt -u nullglob

    local current_pub_fingerprint
    current_pub_fingerprint=$(openssl pkey -pubin -keyform DER -in "$pub_der" -pubout -outform PEM 2>/dev/null)

    for pub in "${pub_keys[@]}"; do
    local trusted_fingerprint
    trusted_fingerprint=$(openssl pkey -pubin -in "$pub" -pubout -outform PEM 2>/dev/null || true)
    if [[ -n "$trusted_fingerprint" && "$trusted_fingerprint" == "$current_pub_fingerprint" ]]; then
        matched=true
        echo -e "${GREEN}✔ Valid signature from trusted source: $(basename "$pub")${NC}"
        break
    fi
    done

    if [[ "$matched" != "true" ]]; then
        if [[ "${ULPM_STRICT_SIGNATURES}" == "true" ]]; then
            echo -e "${RED}[-] Untrusted developer key in strict mode.${NC}" >&2
             rm -f "$sig_bin" "$pub_raw" "$pub_der" "$data_stream"
             return 1
        else
            echo -e "${YELLOW}★ Package signature is authentic, but developer key is not yet in trusted keychain.${NC}"
            read -r -p "Trust this developer key permanently? [y/N]" reply
        if [[ "$reply" =~ ^[yYoO]$ ]]; then
            local auto_key="$TRUSTED_KEYS_DIR/dev_$(date +%s).pub"
            openssl pkey-pubin -keyform DER -in "$pub_der" -pubout -outform PEM > "$auto_key" 2>/dev/null
            echo -e "${GREEN}✔ Key successfully registered in trusted keyring.${NC}"
        else
            echo -e "${YELLOW}Proceeding without adding to trusted keyring (one-time execution)...${NC}"
        fi
        fi
    fi

    rm -f "$sig_bin" "$pub_raw" "$pub_der" "$data_stream"
    return 0
}

# ============================================================
# Manifest validation
# ============================================================

validate_manifest() {
    local manifest="$1"
    if ! jq -e --argjson max_version "$ULPM_FORMAT_VERSION" '
        type == "object" and
        ((.format_version // 1) | type == "number" and . == floor and . >= 1 and . <= $max_version) and
        (.id | type == "string" and test("^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$") and (contains("..") | not)) and
        (.name | type == "string" and length > 0 and length <= 128) and
        ((.version // "1.0.0") | type == "string" and length > 0 and length <= 64) and
        (.exec | type == "string" and length > 0 and length <= 4096 and
         (startswith("/") | not) and
         (split("/") | all(.[]; . != "" and . != "." and . != ".."))) and
        ((.icon // "") | type == "string") and
        ((.chromium // false) | type == "boolean") and
        ((.network // true) | type == "boolean")
    ' "$manifest" >/dev/null 2>&1; then
        echo -e "${RED}[-] Invalid or unsafe manifest${NC}" >&2
        return 1
    fi
    return 0
}

desktop_entry_escape() {
    local value="$1"
    value="${value//\\/\\\\}"
    value="${value//$'\n'/\\n}"
    value="${value//$'\r'/\\r}"
    value="${value//$'\t'/\\t}"
    printf '%s' "$value"
}

# ============================================================
# Extraction & Fat-bundling
# ============================================================

extract_any_payload() {
    local src="$1" dest="$2"

    if [[ -d "$src" ]]; then
        cp -a "$src"/. "$dest/"
    elif [[ "$src" =~ \.(appimage|AppImage)$ ]]; then
        local appimg_tmp
        appimg_tmp=$(mktemp -d "/tmp/ulpm_appimage_XXXXXX")
        chmod +x "$src" 2>/dev/null || true
        (
            cd "$appimg_tmp" || exit 1
            "$src" --appimage-extract >/dev/null 2>&1 || true
        )
        if [[ -d "$appimg_tmp/squashfs-root" ]]; then
            cp -a "$appimg_tmp/squashfs-root"/. "$dest/"
            rm -rf "$appimg_tmp"
        else
            rm -rf "$appimg_tmp"
            echo -e "${RED}[-] Failed to extract AppImage${NC}" >&2
            return 1
        fi
    elif [[ "$src" =~ \.deb$ ]]; then
        dpkg-deb -x "$src" "$dest"
    elif [[ "$src" =~ \.rpm$ ]]; then
        if command -v rpm2cpio &>/dev/null; then
            (cd "$dest" && rpm2cpio "$src" | cpio -idm --quiet)
        elif command -v bsdtar &>/dev/null; then
            bsdtar -xf "$src" -C "$dest"
        else
            echo -e "${RED}[-] rpm2cpio or bsdtar required for .rpm${NC}" >&2
            return 1
        fi
    elif [[ "$src" =~ \.zip$ ]]; then
        unzip -q -o "$src" -d "$dest"
    else
        tar -xf "$src" -C "$dest"
    fi
}

# Improved library filter – avoid bundling core system libraries
is_system_lib() {
    local bname="$1"
    [[ "$bname" =~ ^(ld-linux|ld-musl|libc\.so|libm\.so|libdl\.so|libpthread\.so|librt\.so|libresolv\.so) ]] && return 0
    [[ "$bname" =~ ^(libGL|libEGL|libGLESv|libdrm|libvulkan|libX11|libXext|libXrender|libXrandr) ]] && return 0
    [[ "$bname" =~ ^(libasound|libpulse|libwayland|libffi|libz\.so|libbz2|liblzma|libnss|libnspr) ]] && return 0
    return 1
}

bundle_libs() {
    local root_dir="$1"
    local bin_path="$2"
    local lib_dest="$root_dir/lib"

    mkdir -p "$lib_dest"
    echo -e "${CYAN}-> Inspecting shared libraries (fat bundle)...${NC}"

    local targets=()
    if file -b "$bin_path" 2>/dev/null | grep -q "ELF"; then
        targets+=("$bin_path")
    fi

    while IFS= read -r f; do
        [[ -n "$f" ]] && targets+=("$f")
    done < <(find "$root_dir" -type f -executable 2>/dev/null | while read -r cand; do
        file -b "$cand" 2>/dev/null | grep -q "ELF" && echo "$cand"
    done || true)

    [[ ${#targets[@]} -eq 0 ]] && return 0

    local added=1
    while [[ $added -gt 0 ]]; do
        added=0
        while IFS= read -r lib_file; do
            if [[ -n "$lib_file" && -f "$lib_file" ]]; then
                local bname
                bname=$(basename "$lib_file")
                if ! is_system_lib "$bname"; then
                    if [[ ! -f "$lib_dest/$bname" ]]; then
                        cp -u -L "$lib_file" "$lib_dest/$bname" 2>/dev/null || true
                        added=$((added + 1))
                    fi
                fi
            fi
        done < <(ldd "${targets[@]}" ${lib_dest:+"$lib_dest"/*} 2>/dev/null | grep -oE '/[^ ]+' || true)
    done
}

# ============================================================
# Packaging
# ============================================================

lpk_pack() {
    local source_input="$1"
    local raw_name="${2:-}"
    local out_pkg="${3:-}"
    local version_hint="${4:-latest}"

    ensure_default_key || return 1

    local base_clean app_name app_id work_dir target_arch
    base_clean=$(basename "$source_input")
    base_clean="${base_clean%%.*}"
    app_name="${raw_name:-$base_clean}"
    app_name=$(echo "$app_name" | tr -cd 'a-zA-Z0-9._-')
    app_id="io.lpk.${app_name,,}"
    target_arch="$SYS_ARCH"

    [[ -z "$out_pkg" ]] && out_pkg="${app_name}_${target_arch}.lpk"

    # Already structured LPK source?
    if [[ -d "$source_input" && -f "$source_input/meta/manifest.json" && -d "$source_input/root" ]]; then
        echo -e "${CYAN}-> Pre-structured LPK detected → ${BOLD}$out_pkg${NC}"
        validate_manifest "$source_input/meta/manifest.json" || return 1
        rm -f "$out_pkg"
        mksquashfs "$source_input" "$out_pkg" -comp zstd -noappend -reproducible -quiet || return 1
        cmd_sign "$out_pkg" "$DEFAULT_KEY"
        return 0
    fi

    work_dir=$(mktemp -d "/tmp/ulpm_build_XXXXXX")
    mkdir -p "$work_dir/root" "$work_dir/meta"

    echo -e "${CYAN}-> Extracting payload...${NC}"
    if ! extract_any_payload "$source_input" "$work_dir/root"; then
        rm -rf "$work_dir"
        return 1
    fi

    # Flatten single nested directory
    local entries=("$work_dir/root"/*)
    if [[ ${#entries[@]} -eq 1 && -d "${entries[0]}" ]]; then
        mv "${entries[0]}"/* "$work_dir/root/" 2>/dev/null || true
        rmdir "${entries[0]}" 2>/dev/null || true
    fi

    # Detect main executable
    local detected_exec=""
    while IFS= read -r f; do
        local fname
        fname=$(basename "$f")
        if [[ "${fname,,}" =~ ^(${app_name,,}|${base_clean,,})$ ]]; then
            detected_exec=$(realpath --relative-to="$work_dir/root" "$f")
            break
        fi
    done < <(find "$work_dir/root" -maxdepth 4 -type f -executable 2>/dev/null || true)

    if [[ -z "$detected_exec" ]]; then
        while IFS= read -r f; do
            if file -b "$f" 2>/dev/null | grep -q "ELF.*executable"; then
                detected_exec=$(realpath --relative-to="$work_dir/root" "$f")
                break
            fi
        done < <(find "$work_dir/root" -maxdepth 4 -type f -executable 2>/dev/null || true)
    fi

    if [[ -z "$detected_exec" ]]; then
        detected_exec=$(find "$work_dir/root" -maxdepth 3 -type f -executable 2>/dev/null | head -n1 || true)
        [[ -n "$detected_exec" ]] && detected_exec=$(realpath --relative-to="$work_dir/root" "$detected_exec")
    fi

    if [[ -z "$detected_exec" ]]; then
        echo -e "${RED}[-] No executable binary found${NC}" >&2
        rm -rf "$work_dir"
        return 1
    fi

    bundle_libs "$work_dir/root" "$work_dir/root/$detected_exec"

    # Icon
    local best_icon icon_manifest=""
    best_icon=$(find "$work_dir/root" -type f \( -iname "*.png" -o -iname "*.svg" \) 2>/dev/null \
        | grep -iE "512|256|128|logo|icon|app" | head -n1 || true)
    if [[ -n "$best_icon" && -f "$best_icon" ]]; then
        cp -f "$best_icon" "$work_dir/meta/icon.png"
        icon_manifest="meta/icon.png"
    fi

    local is_chromium=false
    if grep -qiE "chromium|electron" "$work_dir/root/$detected_exec" 2>/dev/null || \
       [[ "$detected_exec" =~ (brave|chrome|chromium|electron) ]]; then
        is_chromium=true
    fi

    cat > "$work_dir/meta/manifest.json" <<EOF
{
  "format_version": $ULPM_FORMAT_VERSION,
  "id": "$app_id",
  "name": "$app_name",
  "version": "$version_hint",
  "arch": "$target_arch",
  "exec": "$detected_exec",
  "icon": "$icon_manifest",
  "chromium": $is_chromium,
  "network": true
}
EOF

    echo -e "  ${CYAN}-> Creating SquashFS [${BOLD}$target_arch${NC}] → ${BOLD}$out_pkg${NC}"
    rm -f "$out_pkg"
    if ! mksquashfs "$work_dir" "$out_pkg" -comp zstd -noappend -reproducible -quiet; then
        rm -rf "$work_dir"
        return 1
    fi
    rm -rf "$work_dir"

    cmd_sign "$out_pkg" "$DEFAULT_KEY"
    return 0
}

lpk_pack_from_apt() {
    local pkg_input="${1:-}"
    local app_name_hint="${2:-}"
    local out_pkg="${3:-}"

    if [[ -z "$pkg_input" ]]; then
        echo -e "${RED}[-] Usage: ulpm deb-pack <package|file.deb> [name]${NC}" >&2
        return 1
    fi

    if ! command -v apt-get &>/dev/null || ! command -v apt-cache &>/dev/null; then
        echo -e "${RED}[-] apt-get / apt-cache required${NC}" >&2
        return 1
    fi

    local build_dir deb_dir root_dir
    build_dir=$(mktemp -d "/tmp/ulpm_apt_XXXXXX")
    deb_dir="$build_dir/debs"
    root_dir="$build_dir/root"
    mkdir -p "$deb_dir" "$root_dir"

    local target_pkg="$pkg_input"
    if [[ -f "$pkg_input" && "$pkg_input" =~ \.deb$ ]]; then
        target_pkg=$(dpkg-deb -f "$pkg_input" Package 2>/dev/null || basename "$pkg_input" .deb)
        cp -f "$pkg_input" "$deb_dir/"
    fi

    local app_name="${app_name_hint:-$target_pkg}"
    echo -e "${BLUE}::${NC} Fetching APT dependencies for '${target_pkg}'..."

    (
        cd "$deb_dir" || exit 1
        [[ ! -f "$pkg_input" ]] && apt-get download "$target_pkg" 2>/dev/null || true
        apt-cache depends --recurse --no-recommends --no-suggests "$target_pkg" 2>/dev/null \
            | grep -E "Depends:" | awk '{print $2}' | grep -v "<" | sort -u \
            | grep -vE "^(libc6|base-files|dpkg|debconf|sensible-utils|init-system-helpers)$" \
            | xargs -r apt-get download 2>/dev/null || true
    )

    for deb in "$deb_dir"/*.deb; do
        [[ -f "$deb" ]] && dpkg-deb -x "$deb" "$root_dir"
    done

    # Remove core system libs that should come from the host
    find "$root_dir" -type f \( -name "ld-linux*.so*" -o -name "libc.so*" \) -delete 2>/dev/null || true

    local pack_status=0
    lpk_pack "$root_dir" "$app_name" "$out_pkg" || pack_status=$?
    rm -rf "$build_dir"
    return $pack_status
}

# ============================================================
# Installation & Runtime
# ============================================================

lpk_install_file() {
    local pkg="$1"
    local repo_origin="${2:-local}"

    if ! verify_package_signature "$pkg"; then
        echo -e "${RED}[-] Installation aborted: signature check failed${NC}" >&2
        return 1
    fi

    local mnt_tmp
    mnt_tmp=$(mktemp -d /tmp/ulpm_inst_XXXXXX)

    cleanup_inst_mount() {
        fusermount -u "$mnt_tmp" 2>/dev/null || fusermount -u -z "$mnt_tmp" 2>/dev/null || true
        rm -rf "$mnt_tmp" 2>/dev/null || true
    }

    if ! squashfuse "$pkg" "$mnt_tmp" 2>/dev/null; then
        echo -e "${RED}[-] Failed to mount package${NC}" >&2
        rm -rf "$mnt_tmp"
        return 1
    fi

    local manifest="$mnt_tmp/meta/manifest.json"
    if [[ ! -f "$manifest" ]] || ! validate_manifest "$manifest"; then
        cleanup_inst_mount
        return 1
    fi

    local id name version icon_file exec_file
    id=$(jq -r '.id' "$manifest")
    name=$(jq -r '.name' "$manifest")
    version=$(jq -r '.version // "1.0.0"' "$manifest")
    icon_file=$(jq -r '.icon // empty' "$manifest")
    exec_file=$(jq -r '.exec' "$manifest")

    local package_root exec_real
    package_root=$(realpath -e -- "$mnt_tmp")
    exec_real=$(realpath -e -- "$package_root/root/$exec_file" 2>/dev/null || true)
    if [[ -z "$exec_real" || ! -x "$exec_real" ]]; then
        echo -e "${RED}[-] Manifest executable missing or not executable${NC}" >&2
        cleanup_inst_mount
        return 1
    fi

    echo -e "${BLUE}::${NC} Installing ${BOLD}$name${NC} ($id)..."

    local target_pkg="$ULPM_APPS/$id.lpk"
    cp -f "$pkg" "$target_pkg"

    local target_icon="$id"
    if [[ -n "$icon_file" && -f "$package_root/$icon_file" ]]; then
        cp -f "$package_root/$icon_file" "$ICON_DIR/$id.png"
        target_icon="$ICON_DIR/$id.png"
    fi

    cleanup_inst_mount

    # Fixed: correct Exec line
    cat > "$DESKTOP_DIR/ulpm-$id.desktop" <<EOF
[Desktop Entry]
Type=Application
Name=$(desktop_entry_escape "$name")
Exec=ulpm run "$id" %U
Icon=$target_icon
Terminal=false
Categories=Utility;Network;Development;AudioVideo;Graphics;
StartupNotify=true
EOF

    update-desktop-database "$DESKTOP_DIR" 2>/dev/null || true
    gtk-update-icon-cache -f -t "$HOME/.local/share/icons/hicolor" 2>/dev/null || true

    local escaped_id
    escaped_id=$(printf '%s\n' "$id" | sed -e 's/[]\/$*.^[]/\\&/g')
    sed -i "/^${escaped_id}|/d" "$ULPM_DB" 2>/dev/null || true
    echo "${id}|${name}|${version}|${repo_origin}|$(date +%s)" >> "$ULPM_DB"

    echo -e "${GREEN}✔ '$name' installed successfully${NC}"
}

lpk_run_isolated() {
    local force_offline=false
    while [[ "${1:-}" =~ ^-- ]]; do
        case "$1" in
            --offline|--no-net) force_offline=true; shift ;;
            *) break ;;
        esac
    done

    local target="${1:-}"
    if [[ -z "$target" ]]; then
        echo -e "${RED}[-] No target specified${NC}" >&2
        exit 1
    fi
    shift || true

    local pkg_path=""
    if [[ -f "$target" ]]; then
        pkg_path="$(realpath "$target")"
    elif [[ -f "$ULPM_APPS/$target.lpk" ]]; then
        pkg_path="$ULPM_APPS/$target.lpk"
    elif [[ -f "$ULPM_APPS/io.lpk.${target,,}.lpk" ]]; then
        pkg_path="$ULPM_APPS/io.lpk.${target,,}.lpk"
    elif [[ "$target" =~ ^https?:// ]] || [[ "$target" =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]]; then
        pkg_path=$(resolve_and_fetch_cached "$target") || exit 1
    else
        echo -e "${RED}[-] Target '$target' could not be resolved${NC}" >&2
        exit 1
    fi

    if ! verify_package_signature "$pkg_path"; then
        echo -e "${RED}[-] Launch aborted: signature check failed${NC}" >&2
        exit 1
    fi

    local mnt_dir
    mnt_dir=$(mktemp -d /tmp/ulpm_run_XXXXXX)

    cleanup_instance() {
        fusermount -u "$mnt_dir" 2>/dev/null || fusermount -u -z "$mnt_dir" 2>/dev/null || true
        rm -rf "$mnt_dir" 2>/dev/null || true
    }
    trap cleanup_instance EXIT INT TERM

    if ! squashfuse "$pkg_path" "$mnt_dir" 2>/dev/null; then
        echo -e "${RED}[-] Failed to mount SquashFS${NC}" >&2
        cleanup_instance
        exit 1
    fi

    local manifest="$mnt_dir/meta/manifest.json"
    if [[ ! -f "$manifest" ]] || ! validate_manifest "$manifest"; then
        cleanup_instance
        exit 1
    fi

    local app_id exec_bin is_chromium allow_net
    app_id=$(jq -r '.id' "$manifest")
    exec_bin=$(jq -r '.exec' "$manifest")
    is_chromium=$(jq -r '.chromium // false' "$manifest")
    allow_net=$(jq -r '.network // true' "$manifest")

    local app_data_dir="$HOME/.var/app/$app_id"
    mkdir -p "$app_data_dir/config" "$app_data_dir/data" "$app_data_dir/cache"

    local run_uid run_user_dir dl_dir exec_dir app_ld_path host_ca_bundle=""
    run_uid="$(id -u)"
    run_user_dir="${XDG_RUNTIME_DIR:-/run/user/$run_uid}"
    dl_dir="$(xdg-user-dir DOWNLOAD 2>/dev/null || echo "$HOME/Downloads")"
    exec_dir="$(dirname "/app/$exec_bin")"
    app_ld_path="/app/lib:/app/usr/lib:/app/usr/lib/x86_64-linux-gnu:/app/usr/lib/aarch64-linux-gnu:$exec_dir${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"

    for ca in /etc/ssl/certs/ca-certificates.crt /etc/pki/tls/certs/ca-bundle.crt /etc/ssl/ca-bundle.pem; do
        [[ -f "$ca" ]] && { host_ca_bundle="$ca"; break; }
    done

    local chromium_flags=()
    if [[ "$is_chromium" == "true" ]] || grep -qiE "chromium|electron" "$mnt_dir/root/$exec_bin" 2>/dev/null; then
        chromium_flags=(
            --no-sandbox
            --test-type
            --disable-gpu-sandbox
            --disable-setuid-sandbox
            --log-level=3
        )
        [[ -n "${WAYLAND_DISPLAY:-}" ]] && chromium_flags+=(--ozone-platform-hint=auto)
    fi

    local bwrap_args=(
        --ro-bind /usr /usr
        --ro-bind-try /lib /lib
        --ro-bind-try /lib64 /lib64
        --ro-bind-try /bin /bin
        --ro-bind-try /sbin /sbin
        --ro-bind-try /etc /etc
        --ro-bind /sys /sys
        --proc /proc
        --dev /dev
        --tmpfs /dev/shm
        --bind /tmp /tmp
        --dev-bind-try /dev/dri /dev/dri
        --ro-bind-try /run/dbus/system_bus_socket /run/dbus/system_bus_socket
        --bind-try "$run_user_dir" "$run_user_dir"
        --ro-bind-try "$HOME/.Xauthority" "$HOME/.Xauthority"
        --ro-bind-try /usr/share/fonts /usr/share/fonts
        --ro-bind-try /usr/share/themes /usr/share/themes
        --ro-bind-try /usr/share/icons /usr/share/icons
        --ro-bind-try "$HOME/.icons" "$HOME/.icons"
        --ro-bind-try "$HOME/.config/gtk-3.0" "$HOME/.config/gtk-3.0"
        --ro-bind-try "$HOME/.config/fontconfig" "$HOME/.config/fontconfig"
        --bind "$dl_dir" "$dl_dir"
        --bind "$app_data_dir/config" "$HOME/.config"
        --bind "$app_data_dir/data" "$HOME/.local/share"
        --bind "$app_data_dir/cache" "$HOME/.cache"
        --ro-bind "$mnt_dir/root" /app
    )

    if [[ "$force_offline" == "true" || "$allow_net" == "false" ]]; then
        bwrap_args+=(--unshare-net)
    else
        bwrap_args+=(
            --ro-bind-try /etc/resolv.conf /etc/resolv.conf
            --ro-bind-try /run/resolvconf /run/resolvconf
            --ro-bind-try /run/systemd/resolve /run/systemd/resolve
        )
    fi

    [[ -n "$host_ca_bundle" ]] && bwrap_args+=(--ro-bind-try "$host_ca_bundle" /etc/ssl/certs/ca-certificates.crt)

    for dev in /dev/nvidia*; do
        [[ -e "$dev" ]] && bwrap_args+=(--dev-bind "$dev" "$dev")
    done

    # Note: full session D-Bus is still exposed.
    # Future improvement: use xdg-dbus-proxy for finer control.

    bwrap "${bwrap_args[@]}" \
--setenv PATH "/app/bin:/app/usr/bin:/usr/local/bin:/usr/bin:/bin" \
--setenv DISPLAY "${DISPLAY:-}" \
--setenvWAYLAND_DISPLAY "${WAYLAND_DISPLAY:-}" \
--setenv XDG_RUNTIME_DIR "$run_user_dir" \
--setenv XDG_CONFIG_DIRS "/app/etc/xdg:/etc/xdg" \
--setenv XDG_DATA_DIRS "/app/usr/share:/app/share:/usr/local/share:/usr/share" \
--setenv SSL_CERT_FILE "${host_ca_bundle:-}" \
--setenv PULSE_SERVER "${PULSE_SERVER:-unix:$run_user_dir/pulse/native}" \
--setenv PIPEWIRE_RUNTIME_DIR "$run_user_dir" \
--setenv DBUS_SESSION_BUS_ADDRESS "${DBUS_SESSION_BUS_ADDRESS:-unix:path=$run_user_dir/bus}" \
--setenv LD_LIBRARY_PATH "$app_ld_path" \
--chdir /app \
"/app/$exec_bin" "${chromium_flags[@]}" "$@" || true
}

# ============================================================
# Cache & Streaming
# ============================================================

resolve_and_fetch_cached() {
    local target="$1"
    local dl_url="" cache_file=""

    if [[ "$target" =~ ^https?://.*\.lpk$ ]]; then
        dl_url="$target"
        local hash
        hash=$(printf "%s" "$target" | md5sum | cut -d' ' -f1)
        cache_file="$CACHE_PKG_DIR/${hash}.lpk"
    else
        local repo_path
        repo_path=$(echo "$target" | sed -E 's#^https?://github.com/##; s#/$##; s#\.git$##')
        local release_json
        release_json=$(fetch_github_api "repos/${repo_path}/releases/latest") || return 1
        dl_url=$(find_lpk_download_url "$release_json" "$ARCH_REGEX")
        if [[ -z "$dl_url" ]]; then
            echo -e "${RED}[-] No .lpk found for this architecture${NC}" >&2
            return 1
        fi
        local tag_name safe_repo
        tag_name=$(echo "$release_json" | jq -r '.tag_name // "latest"')
        safe_repo=$(echo "$repo_path" | tr '/' '_')
        cache_file="$CACHE_PKG_DIR/${safe_repo}_${tag_name}.lpk"
    fi

    if [[ -f "$cache_file" ]]; then
        echo -e "${CYAN}-> Checking for updates...${NC}"
        curl -fsSL --time-cond "$cache_file" -o "$cache_file.part" "$dl_url" 2>/dev/null || true
        if [[ -s "$cache_file.part" ]]; then
            mv -f "$cache_file.part" "$cache_file"
            echo -e "${GREEN}✔ Updated${NC}"
        else
            rm -f "$cache_file.part"
            echo -e "${GREEN}✔ Cache up-to-date${NC}"
        fi
    else
        echo -e "${BLUE}::${NC} Downloading into cache..."
        curl -fsSL --progress-bar -o "$cache_file" "$dl_url" || { rm -f "$cache_file"; return 1; }
    fi

    echo "$cache_file"
}

cmd_stream() {
    local target="${1:-}"
    if [[ -z "$target" ]]; then
        echo -e "${RED}[-] Usage: ulpm stream <url|owner/repo> [args...]${NC}" >&2
        return 1
    fi
    shift || true

    local tmp_lpk="$TEMP_DIR/streamed.lpk"
    local dl_url=""

    if [[ "$target" =~ ^https?://.*\.lpk$ ]]; then
        dl_url="$target"
    else
        local repo_path
        repo_path=$(echo "$target" | sed -E 's#^https?://github.com/##; s#/$##; s#\.git$##')
        local release_json
        release_json=$(fetch_github_api "repos/${repo_path}/releases/latest") || return 1
        dl_url=$(find_lpk_download_url "$release_json" "$ARCH_REGEX")
        if [[ -z "$dl_url" ]]; then
            echo -e "${RED}[-] No .lpk found for $repo_path${NC}" >&2
            return 1
        fi
    fi

    echo -e "${BLUE}::${NC} Streaming to ephemeral storage..."
    curl -fsSL --progress-bar -o "$tmp_lpk" "$dl_url" || return 1

    echo -e "${CYAN}-> Launching ephemeral container...${NC}"
    lpk_run_isolated "$tmp_lpk" "$@"

    echo -e "${GREEN}✔ Ephemeral run finished – everything cleaned${NC}"
}

# ============================================================
# CLI commands
# ============================================================

cmd_install_target() {
    local target="$1"
    local app_name_hint="${2:-}"

    if [[ -f "$target" && "$target" =~ \.lpk$ ]]; then
        lpk_install_file "$target" "local"
        return $?
    fi

    if [[ -d "$target" || "$target" =~ \.(appimage|AppImage|deb|rpm|tar\..*|tgz|zip)$ ]]; then
        local out_lpk="$TEMP_DIR/bundle_${SYS_ARCH}.lpk"
        lpk_pack "$target" "$app_name_hint" "$out_lpk" || return 1
        lpk_install_file "$out_lpk" "local"
        return $?
    fi

    local repo_path
    repo_path=$(echo "$target" | sed -E 's#^https?://github.com/##; s#/$##; s#\.git$##')
    local release_json
    release_json=$(fetch_github_api "repos/${repo_path}/releases/latest") || return 1

    local lpk_url
    lpk_url=$(find_lpk_download_url "$release_json" "$ARCH_REGEX")

    if [[ -n "$lpk_url" ]]; then
        local tmp_lpk="$TEMP_DIR/downloaded.lpk"
        echo -e "${GREEN}✔ Downloading remote .lpk...${NC}"
        curl -fsSL --progress-bar -o "$tmp_lpk" "$lpk_url" || return 1
        lpk_install_file "$tmp_lpk" "$repo_path"
        return $?
    fi

    local dl_url
    dl_url=$(find_archive_download_url "$release_json" "$ARCH_REGEX")
    if [[ -z "$dl_url" ]]; then
        echo -e "${RED}[-] No compatible binary found${NC}" >&2
        return 1
    fi

    local tmp_archive="$TEMP_DIR/archive_dl"
    curl -fsSL --progress-bar -o "$tmp_archive" "$dl_url" || return 1
    local auto_lpk="$TEMP_DIR/generated_${SYS_ARCH}.lpk"
    lpk_pack "$tmp_archive" "${app_name_hint:-$(echo "$repo_path" | cut -d'/' -f2)}" "$auto_lpk" || return 1
    lpk_install_file "$auto_lpk" "$repo_path"
}

cmd_upgrade() {
    echo -e "${BOLD}${CYAN}Checking for updates...${NC}"
    if [[ ! -s "$ULPM_DB" ]]; then
        echo -e "${GRAY}No tracked packages installed.${NC}"
        return 0
    fi

    while IFS='|' read -r id name ver repo _; do
        [[ "$repo" == "local" || -z "$repo" ]] && continue
        local rel_data tag_remote
        rel_data=$(fetch_github_api "repos/${repo}/releases/latest") || continue
        tag_remote=$(echo "$rel_data" | jq -r '.tag_name // empty' | tr -d '\r')

        if [[ -n "$tag_remote" && "${tag_remote#v}" != "${ver#v}" ]]; then
            echo -e "  ${YELLOW}★ Update available for $name: $ver → $tag_remote${NC}"
            cmd_install_target "$repo" "$name"
        else
            echo -e "  ${GREEN}✔ $name is up to date ($ver)${NC}"
        fi
    done < "$ULPM_DB"
}

cmd_remove() {
    local target="${1:-}"
    if [[ -z "$target" ]]; then
        echo -e "${RED}[-] Specify package to remove${NC}" >&2
        return 1
    fi

    local id="io.lpk.${target,,}"
    [[ "$target" =~ ^io\.lpk\. ]] && id="$target"

    rm -f "$ULPM_APPS/$id.lpk" \
          "$DESKTOP_DIR/ulpm-$id.desktop" \
          "$ICON_DIR/$id.png"

    sed -i "/^$(printf '%s\n' "$id" | sed -e 's/[]\/$*.^[]/\\&/g')|/d" "$ULPM_DB" 2>/dev/null || true
    update-desktop-database "$DESKTOP_DIR" 2>/dev/null || true
    echo -e "${GREEN}✔ Removed $id${NC}"
}

cmd_list() {
    echo -e "${BOLD}${CYAN}Installed ULPM packages:${NC}"
    echo -e "${BLUE}---------------------------------------------------------${NC}"
    if [[ -s "$ULPM_DB" ]]; then
        while IFS='|' read -r id name ver repo _; do
            printf "  ${BOLD}%-25s${NC} ${GREEN}%-12s${NC} ${GRAY}(%s)${NC}\n" "$name" "$ver" "$repo"
        done < "$ULPM_DB"
    else
        echo -e "  ${GRAY}(No packages installed)${NC}"
    fi
    echo -e "${BLUE}---------------------------------------------------------${NC}"
}

usage() {
    cat <<EOF
ULPM - Universal Linux Package Manager (LPK Engine v3.1)

Usage: ulpm <command> [options]

Core:
  stream <url|owner/repo> [args]   Ephemeral launch from web/RAM
  run [--offline] <pkg|id|url>     Run in Bubblewrap sandbox
  install, -i <source> [name]      Install (.lpk / AppImage / deb / rpm / GitHub...)
  pack <source> [name] [out]       Create signed .lpk
  deb-pack <pkg|deb> [name]        Pack with recursive APT dependencies
  upgrade, -u                      Update GitHub-tracked packages
  remove, -r <id>                  Uninstall
  list, -l                         List installed packages

Cryptography:
  keygen [name]                    Generate Ed25519 keypair
  sign <file.lpk> [privkey]        Embed signature footer
  trust <file.pub>                 Trust a public key
EOF
    exit 0
}

# ============================================================
# Entry point
# ============================================================

[[ $# -eq 0 ]] && usage

ACTION="$1"
shift || true

case "$ACTION" in
    stream)            cmd_stream "$@" ;;
    run)               lpk_run_isolated "$@" ;;
    install|-i|add|-a) cmd_install_target "$@" ;;
    pack)              lpk_pack "$@" ;;
    deb-pack)          lpk_pack_from_apt "$@" ;;
    upgrade|-u)        cmd_upgrade ;;
    remove|-r)         cmd_remove "$@" ;;
    list|-l)           cmd_list ;;
    keygen)            cmd_keygen "$@" ;;
    sign)              cmd_sign "$@" ;;
    trust)             cmd_trust "$@" ;;
    help|-h|--help)    usage ;;
    *)
        echo -e "${RED}[-] Unknown command: $ACTION${NC}"
        usage
        ;;
esac
