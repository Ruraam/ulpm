#!/usr/bin/env bash
# ==============================================================================
# ULRM - Automated management of a signed ULPM repository
# Usage:
#   ulrm init
#   ulrm add myapp.lpk
#   ulrm rebuild
#   ulrm publish
# ==============================================================================

set -euo pipefail

# ====================== CONFIGURATION ======================
REPO_NAME="myrepo"
REPO_DIR="${REPO_DIR:-$HOME/ulpm-repo}"
PACKAGES_DIR="${PACKAGES_DIR:-$REPO_DIR/packages}"
KEY_NAME="${KEY_NAME:-release_key}"
KEY_DIR="${ULPM_CONFIG_HOME:-${XDG_CONFIG_HOME:-$HOME/.config}/ulpm}/keys"
PRIVATE_KEY="$KEY_DIR/${KEY_NAME}.key"
PUBLIC_KEY="$KEY_DIR/${KEY_NAME}.pub"

# Publishing
PUBLISH_METHOD="${PUBLISH_METHOD:-github}"                       # local | rsync | github
REMOTE_PATH="${REMOTE_PATH:-user@server:/var/www/ulpm/}"         # for rsync

# GitHub Pages
GITHUB_REPO="${GITHUB_REPO:-your-user/ulpm-packages}"            # owner/repo
GITHUB_BRANCH="${GITHUB_BRANCH:-gh-pages}"                       # publishing branch
GITHUB_TOKEN="${GITHUB_TOKEN:-}"                                  # optional token override
# ============================================================

info()  { printf '\033[1;32m[INFO]\033[0m  %s\n' "$*"; }
warn()  { printf '\033[1;33m[WARN]\033[0m  %s\n' "$*"; }
error() { printf '\033[1;31m[ERROR]\033[0m %s\n' "$*" >&2; exit 1; }

# Source lib/repo.sh
SELF_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
for candidate in \
    "$SELF_DIR/../lib/repo.sh" \
    "$SELF_DIR/../lib/ulpm/repo.sh" \
    "${HOME}/.local/lib/ulpm/repo.sh" \
    "/usr/local/lib/ulpm/repo.sh" \
    "/usr/lib/ulpm/repo.sh"; do
    if [[ -f "$candidate" ]]; then
        # shellcheck disable=SC1090
        source "$candidate"
        break
    fi
done

check_ulpm() {
    command -v ulpm >/dev/null 2>&1 || error "ulpm is not installed or not in PATH"
}

cmd_init() {
    check_ulpm
    mkdir -p "$PACKAGES_DIR"
    mkdir -p "$KEY_DIR"

    if [[ ! -f "$PRIVATE_KEY" ]]; then
        info "Generating Ed25519 key '$KEY_NAME'..."
        ulpm keygen "$KEY_NAME"
    else
        info "Key already exists: $PRIVATE_KEY"
    fi

    [[ -f "$PUBLIC_KEY" ]] || error "Public key not found: $PUBLIC_KEY"

    info "Repository initialized at: $REPO_DIR"
    info "Public key to distribute: $PUBLIC_KEY"
    echo
    echo "Next steps:"
    echo "  1. Place your .lpk files in $PACKAGES_DIR"
    echo "  2. Run: $0 rebuild"
    echo "  3. Then: $0 publish"
}

cmd_add() {
    check_ulpm
    [[ $# -ge 1 ]] || error "Usage: $0 add <file.lpk> [file2.lpk ...]"

    mkdir -p "$PACKAGES_DIR"

    for pkg in "$@"; do
        [[ -f "$pkg" ]] || { warn "File not found: $pkg"; continue; }

        local dest="$PACKAGES_DIR/$(basename "$pkg")"
        cp -f -- "$pkg" "$dest"
        info "Copied: $(basename "$pkg")"

        local is_signed=0
        if ulpm inspect "$dest" 2>/dev/null | grep -qi "verified"; then
            is_signed=1
        elif ulpm verify "$dest" 2>/dev/null; then
            is_signed=1
        fi

        if (( is_signed == 0 )); then
            [[ -f "$PRIVATE_KEY" ]] || error "Cannot sign package: private key not found ($PRIVATE_KEY)"
            info "Signing package $(basename "$dest")..."
            ulpm sign "$dest" "$PRIVATE_KEY"
        fi
    done

    info "Packages added. Run '$0 rebuild' to update the index."
}

cmd_rebuild() {
    check_ulpm
    [[ -d "$PACKAGES_DIR" ]] || error "Packages directory not found: $PACKAGES_DIR"
    [[ -f "$PRIVATE_KEY" ]] || error "Private key not found: $PRIVATE_KEY"

    info "Generating signed index..."
    if declare -F repo_build_and_sign_index >/dev/null 2>&1; then
        repo_build_and_sign_index "$PACKAGES_DIR" "$PRIVATE_KEY"
    else
        ulpm repo index "$PACKAGES_DIR" "$PRIVATE_KEY"
    fi

    if [[ -f "$PACKAGES_DIR/index.json" && -f "$PACKAGES_DIR/index.json.sig" ]]; then
        local count
        count=$(jq '.packages | length' "$PACKAGES_DIR/index.json" 2>/dev/null || echo "?")
        info "Index generated successfully ($count package(s))"
        info "  → $PACKAGES_DIR/index.json"
        info "  → $PACKAGES_DIR/index.json.sig"
    else
        error "Failed to generate the index"
    fi
}

cmd_publish() {
    [[ -f "$PACKAGES_DIR/index.json" ]] || error "Index missing. Run '$0 rebuild' first"

    case "$PUBLISH_METHOD" in
        local)
            info "Local repository ready: $PACKAGES_DIR"
            echo "  ulpm repo add $REPO_NAME $PACKAGES_DIR $PUBLIC_KEY"
            ;;

        rsync)
            info "Publishing via rsync → $REMOTE_PATH"
            rsync -avz --delete "$PACKAGES_DIR/" "$REMOTE_PATH"
            info "Publish completed."
            ;;

        github)
            command -v git >/dev/null 2>&1 || error "git is required"
            command -v gh >/dev/null 2>&1 || warn "gh (GitHub CLI) is recommended for easier authentication"

            info "Preparing GitHub Pages publish..."

            local gh_dir="$REPO_DIR/github-pages"
            local repo_url="https://github.com/${GITHUB_REPO}.git"
            if [[ -n "$GITHUB_TOKEN" ]]; then
                repo_url="https://x-access-token:${GITHUB_TOKEN}@github.com/${GITHUB_REPO}.git"
            fi

            if [[ -d "$gh_dir/.git" ]]; then
                git -C "$gh_dir" pull origin "$GITHUB_BRANCH" || true
            else
                mkdir -p "$REPO_DIR"
                git clone --branch "$GITHUB_BRANCH" --single-branch \
                    "$repo_url" "$gh_dir" 2>/dev/null \
                    || git clone "$repo_url" "$gh_dir"
                git -C "$gh_dir" checkout -B "$GITHUB_BRANCH"
            fi

            rsync -a --delete \
                --exclude='.git' \
                "$PACKAGES_DIR/" "$gh_dir/"

            (
                cd "$gh_dir"
                git add .
                if git diff --cached --quiet; then
                    info "No changes to publish."
                else
                    git commit -m "Update ULPM repository $(date -u +%Y-%m-%dT%H:%M:%SZ)"
                    git push origin "$GITHUB_BRANCH"
                    local owner repo_slug
                    owner="${GITHUB_REPO%%/*}"
                    repo_slug="${GITHUB_REPO#*/}"
                    info "Published at https://${owner}.github.io/${repo_slug}/"
                fi
            )

            local owner repo_slug
            owner="${GITHUB_REPO%%/*}"
            repo_slug="${GITHUB_REPO#*/}"
            echo
            echo "Users can add the repository with:"
            echo "  ulpm repo add $REPO_NAME https://${owner}.github.io/${repo_slug}/ $PUBLIC_KEY"
            ;;

        *)
            error "Invalid PUBLISH_METHOD: $PUBLISH_METHOD"
            ;;
    esac
}

cmd_help() {
    cat <<EOF
Usage: $0 <command> [options]

Commands:
  init              Initialize the repository and generate the Ed25519 key
  add <files>       Add (and sign) one or more .lpk packages
  rebuild           Regenerate index.json + index.json.sig
  publish           Publish the repository (according to PUBLISH_METHOD)
  help              Show this help

Full workflow example:
  $0 init
  $0 add ./firefox.lpk ./vlc.lpk
  $0 rebuild
  $0 publish
EOF
}

case "${1:-}" in
    init)              shift; cmd_init "$@" ;;
    add)               shift; cmd_add "$@" ;;
    rebuild|index)     shift; cmd_rebuild "$@" ;;
    publish)           shift; cmd_publish "$@" ;;
    help|-h|--help|"") cmd_help ;;
    *)                 error "Unknown command: $1 (use 'help')" ;;
esac
