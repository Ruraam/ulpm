#!/usr/bin/env bash
# ==============================================================================
# ulpm - Universal Linux Package Manager
# Rootless, Zero-Daemon, Sandboxed Application Engine
# ==============================================================================

set -euo pipefail

# Format & Engine Version
export ULPM_VERSION="4.0.0"
export ULPM_FORMAT_VERSION=4

# Resolve runtime paths
ULPM_BIN_DIR="$(dirname "$(realpath "${BASH_SOURCE[0]}")")"
ULPM_ROOT_DIR="$(cd "$ULPM_BIN_DIR/.." && pwd)"
export ULPM_ROOT_DIR

# Multi-path library discovery
if [ -d "$ULPM_ROOT_DIR/lib" ]; then
    export ULPM_LIB_DIR="$ULPM_ROOT_DIR/lib"
elif [ -d "$HOME/.local/lib/ulpm" ]; then
    export ULPM_LIB_DIR="$HOME/.local/lib/ulpm"
elif [ -d "/usr/local/lib/ulpm" ]; then
    export ULPM_LIB_DIR="/usr/local/lib/ulpm"
elif [ -d "/usr/lib/ulpm" ]; then
    export ULPM_LIB_DIR="/usr/lib/ulpm"
else
    echo "[X] Critical: Unable to locate ULPM library directory." >&2
    exit 1
fi

# XDG Standard Directories
export ULPM_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}/ulpm"
export ULPM_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}/ulpm"
export ULPM_CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}/ulpm"
export ULPM_APPS_DIR="$ULPM_DATA_HOME/apps"
export ULPM_KEYS_DIR="$ULPM_CONFIG_HOME/keys"

# Verify that all required modules are present before sourcing
for mod in utils crypto sandbox pack deb run stream manage; do
    if [ ! -f "$ULPM_LIB_DIR/$mod.sh" ]; then
        echo "[X] Critical: Module '$mod.sh' not found in $ULPM_LIB_DIR" >&2
        exit 1
    fi
    # shellcheck disable=SC1090
    source "$ULPM_LIB_DIR/$mod.sh"
done

init_environment

show_help() {
    cat <<EOF
ulpm - Universal Linux Package Manager (v${ULPM_VERSION})

USAGE:
    ulpm <COMMAND> [OPTIONS] [ARGUMENTS]

EXECUTION COMMANDS:
    run <package.lpk|app_name> [flags] [-- args...]   Run an isolated application
    stream <url|repo|package.lpk> [flags]             Run ephemerally in RAM/tmpfs without installing

PACKAGING COMMANDS:
    pack <folder|archive|appimage> [name] [out.lpk]  Create a standalone .lpk bundle
    deb-pack <package_name|file.deb> [name]           Fetch and package via APT dependencies

MANAGEMENT COMMANDS:
    install <package.lpk|url>                         Install an application locally
    remove [--purge] <app_name>                       Uninstall an application
    list                                               List installed applications
    upgrade [app_name]                                Upgrade installed packages
    clean                                              Clean up cache and dangling mounts

CRYPTOGRAPHIC COMMANDS:
    keygen <key_name>                                 Generate an Ed25519 keypair
    sign <package.lpk> [private_key]                  Sign an .lpk package
    trust <public_key.pub>                            Trust a public key

SANDBOX RUNTIME FLAGS:
    --offline              Disable network access
    --no-gpu              Disable hardware acceleration (Mesa/Vulkan)
    --no-audio            Disable sound server access (PipeWire/PulseAudio)
    --no-gui              Disable Wayland and X11 display access
    --bind <host>:<dest>  Bind mount a host folder into the sandbox

ENVIRONMENT VARIABLES:
    ULPM_ZSTD_LEVEL=1..22   Compression level for 'pack' (default: 19)
    Level 15 is recommended for 5x faster packing
    with ~98% of the compression ratio.
    Example: ULPM_ZSTD_LEVEL=15 ulpm pack my_app/

For detailed help on a specific command: ulpm <COMMAND> --help
EOF
}

# Command dispatcher
main() {
    if [ $# -eq 0 ]; then
        show_help
        exit 0
    fi

    local cmd="$1"
    shift

    case "$cmd" in
        run)        cmd_run "$@" ;;
        stream)     cmd_stream "$@" ;;
        pack)       cmd_pack "$@" ;;
        deb-pack)   cmd_deb_pack "$@" ;;
        install)    cmd_install "$@" ;;
        remove|rm)  cmd_remove "$@" ;;
        list|ls)    cmd_list "$@" ;;
        upgrade)
            if command -v cmd_upgrade &>/dev/null; then
                cmd_upgrade "$@"
            else
                info "Upgrade feature is checking local applications..."
                warn "To update an application, re-install the latest .lpk package."
            fi
            ;;
        clean)      cmd_clean "$@" ;;
        keygen)     generate_keypair "$@" ;;
        sign)       sign_package "$@" ;;
        trust)      trust_key "$@" ;;
        -h|--help|help) show_help ;;
        -v|--version|version) echo "ulpm v${ULPM_VERSION}" ;;
        *)
            error "Unknown command: $cmd"
            show_help
            exit 1
            ;;
    esac
}

main "$@"
